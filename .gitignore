**/stats/
*.parquet

# Legacy analysis directories (obsolete - replaced by results/ and final-results/)
analysis/data/
analysis/figures/

# Experiment results (raw data and analysis outputs)
# These are large and should be stored separately (e.g., GCS for GCP, local storage for native/minikube)
results/
**/results/
# Note: Raw JSONL files are benchmark data but too large for git. Store in external storage.

# Test results (temporary test outputs from development/testing)
test-results/
