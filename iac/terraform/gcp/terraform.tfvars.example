# Example Terraform variables for GCP deployment
# Copy this file to terraform.tfvars and update with your values

# Required variables
project_id  = "your-gcp-project-id"
bucket_name = "qr-results-your-project-id"

# Optional - override defaults
region = "us-central1"

# GKE configuration
gke_name              = "pqc-bench"
gke_node_machine_type = "n2-standard-4"
gke_node_min_count    = 1
gke_node_max_count    = 7
gke_initial_node_count = 1

# Container images (update after pushing to GCR)
# orchestrator_image = "gcr.io/your-project-id/qr-orchestrator:latest"
# worker_image       = "gcr.io/your-project-id/pqc-bench:latest"

# Monitoring
enable_prometheus      = true
grafana_admin_password = "admin"  # Change in production!

# Optional BigQuery export
enable_bigquery     = false
bigquery_dataset_id = "quantum_resilient_results"

# Resource labels
labels = {
  application = "quantum-resilient"
  environment = "development"
  managed-by  = "terraform"
}

