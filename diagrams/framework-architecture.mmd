graph TB
    subgraph CONFIG_LAYER["Configuration Layer"]
        MATRIX[Experiment Matrix<br/>YAML Declarative Config]
        GEN_SCENARIOS[Scenario Generator<br/>Python Script]
        SCENARIOS[Individual Scenarios<br/>YAML Files]
        RNG_SEED[RNG Seed Computation<br/>Deterministic from Parameters]
    end
    
    subgraph DEPLOY["Deployment Layer"]
        BM[Bare-metal<br/>Native Execution]
        K8S[Kubernetes<br/>Container Orchestration]
        CLOUD[Cloud Deployment<br/>GCP GKE]
    end
    
    subgraph ORCH["Orchestration and Metrics Layer"]
        ORCH_RUST[Rust Orchestrator<br/>Coordinator, Controller]
        PYTHON_ORCH[Python Orchestration<br/>Experiment Execution]
        AGG[Data Aggregator<br/>Multi-run Combination]
        STATS[Statistical Analysis<br/>Hypothesis Testing, Effect Sizes]
    end
    
    subgraph EXEC["Cryptographic Execution Layer"]
        PIPELINE[Streaming Pipeline<br/>Async Event Processing]
        EXEC_MODE[Execution Modes<br/>Single, FixedPool, Elastic]
        WORKLOAD[Workload Generator<br/>Patterns: Constant, Burst, Ramp]
        PAYLOAD[Payload Generation<br/>Deterministic RNG]
        CRYPTO[Crypto Adapters<br/>PQC & Classical<br/>Unified Interface]
        TELEMETRY[Telemetry Collection<br/>Timing, Resources, Events]
        CONTROL[Control Plane<br/>Health, Readiness Endpoints]
    end
    
    subgraph OUTPUT["Telemetry Outputs"]
        JSONL[Event Logs<br/>JSONL Format]
        CSV[Statistical Summaries<br/>CSV/JSON]
        METADATA[Environment Metadata<br/>Deployment Context]
    end
    
    subgraph ANALYSIS["Analysis Layer"]
        HYPOTHESIS[Hypothesis Testing<br/>t-test, Mann-Whitney U]
        EFFECT_SIZE[Effect Size Computation<br/>Cohen's d, Confidence Intervals]
        STATS_COMPUTE[Statistics Computation<br/>Percentiles, Aggregates]
        VISUALIZATION[Visualization Scripts<br/>CDFs, Comparison Charts]
        NOTEBOOKS[Jupyter Notebooks<br/>Exploratory Analysis]
        EXPORT[Export Utilities<br/>Dataset Export, Merge]
    end
    
    MATRIX --> GEN_SCENARIOS
    GEN_SCENARIOS --> SCENARIOS
    GEN_SCENARIOS --> RNG_SEED
    SCENARIOS --> PYTHON_ORCH
    RNG_SEED --> PAYLOAD
    PYTHON_ORCH --> ORCH_RUST
    ORCH_RUST --> PIPELINE
    ORCH_RUST --> AGG
    ORCH_RUST --> STATS
    
    PIPELINE --> EXEC_MODE
    EXEC_MODE --> WORKLOAD
    WORKLOAD --> PAYLOAD
    PAYLOAD --> CRYPTO
    CRYPTO --> TELEMETRY
    TELEMETRY --> JSONL
    TELEMETRY --> CSV
    TELEMETRY --> METADATA
    PIPELINE --> CONTROL
    
    JSONL --> AGG
    CSV --> AGG
    METADATA --> AGG
    AGG --> STATS
    STATS --> HYPOTHESIS
    STATS --> EFFECT_SIZE
    STATS --> STATS_COMPUTE
    JSONL --> VISUALIZATION
    CSV --> VISUALIZATION
    JSONL --> NOTEBOOKS
    CSV --> NOTEBOOKS
    STATS_COMPUTE --> EXPORT
    
    BM --> PIPELINE
    K8S --> PIPELINE
    CLOUD --> PIPELINE
    
