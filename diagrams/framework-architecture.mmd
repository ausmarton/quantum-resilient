%% Figure 3.1: Only the five layers and flow referenced in Section 3.1.4
%% Caption: "flow from configuration and workload generation through execution and measurement to analysis outputs"
graph LR
    subgraph L1["1. Configuration layer"]
        CONFIG[Defines parameters<br/>workload generation]
    end
    subgraph L2["2. Orchestration layer"]
        ORCH[Generates and schedules<br/>workloads]
    end
    subgraph L3["3. Execution layer"]
        EXEC[Invokes cryptographic<br/>operations]
    end
    subgraph L4["4. Instrumentation layer"]
        INST[Captures timing<br/>and resource metrics]
    end
    subgraph L5["5. Analysis layer"]
        ANALYSIS[Distributional summaries<br/>and statistical outputs]
    end
    CONFIG --> ORCH
    ORCH --> EXEC
    EXEC --> INST
    INST --> ANALYSIS

    classDef config fill:#b3e5fc,stroke:#000,stroke-width:3px
    classDef orch fill:#ce93d8,stroke:#000,stroke-width:3px
    classDef exec fill:#ffb74d,stroke:#000,stroke-width:3px
    classDef inst fill:#fff9c4,stroke:#000,stroke-width:3px
    classDef analysis fill:#81c784,stroke:#000,stroke-width:3px
    class CONFIG config
    class ORCH orch
    class EXEC exec
    class INST inst
    class ANALYSIS analysis
