{# Template for generating LaTeX summary tables #}

{% macro latency_table(stats) %}
\begin{table}[htbp]
\centering
\caption{Latency Distribution ({{ experiment_id }})}
\label{tab:latency-{{ experiment_id | replace("_", "-") }}}
\begin{tabular}{l S[table-format=6.1]}
\toprule
\textbf{Statistic} & \textbf{Value (\si{\micro\second})} \\
\midrule
Count & {{ stats.count | int }} \\
Mean & {{ "%.1f" | format(stats.mean) }} \\
Std Dev & {{ "%.1f" | format(stats.std) }} \\
Min & {{ "%.1f" | format(stats.min) }} \\
p50 (Median) & {{ "%.1f" | format(stats.p50) }} \\
p90 & {{ "%.1f" | format(stats.p90) }} \\
p95 & {{ "%.1f" | format(stats.p95) }} \\
p99 & {{ "%.1f" | format(stats.p99) }} \\
p99.9 & {{ "%.1f" | format(stats.p999) }} \\
Max & {{ "%.1f" | format(stats.max) }} \\
\bottomrule
\end{tabular}
\end{table}
{% endmacro %}

{% macro throughput_table(stats) %}
\begin{table}[htbp]
\centering
\caption{Throughput Statistics ({{ experiment_id }})}
\label{tab:throughput-{{ experiment_id | replace("_", "-") }}}
\begin{tabular}{l S[table-format=6.1]}
\toprule
\textbf{Metric} & \textbf{Value} \\
\midrule
Duration & {{ "%.2f" | format(stats.total_duration_sec) }} s \\
Total Messages & {{ stats.total_messages | int }} \\
Mean Throughput & {{ "%.1f" | format(stats.mean_msgs_per_sec) }} msg/s \\
Max Throughput & {{ "%.1f" | format(stats.max_msgs_per_sec) }} msg/s \\
Min Throughput & {{ "%.1f" | format(stats.min_msgs_per_sec) }} msg/s \\
Std Dev & {{ "%.1f" | format(stats.std_msgs_per_sec) }} msg/s \\
\bottomrule
\end{tabular}
\end{table}
{% endmacro %}

{% macro algorithm_comparison_table(per_algorithm) %}
\begin{table}[htbp]
\centering
\caption{Algorithm Latency Comparison ({{ experiment_id }})}
\label{tab:algorithm-comparison-{{ experiment_id | replace("_", "-") }}}
\begin{tabular}{l S[table-format=6.0] S[table-format=6.1] S[table-format=6.1] S[table-format=6.1] S[table-format=6.1]}
\toprule
\textbf{Algorithm} & \textbf{N} & \textbf{Mean (\si{\micro\second})} & \textbf{Std} & \textbf{p50} & \textbf{p99} \\
\midrule
{% for algo, s in per_algorithm.items() %}
{{ algo }} & {{ s.count | int }} & {{ "%.1f" | format(s.mean) }} & {{ "%.1f" | format(s.std) }} & {{ "%.1f" | format(s.p50) }} & {{ "%.1f" | format(s.p99) }} \\
{% endfor %}
\bottomrule
\end{tabular}
\end{table}
{% endmacro %}

{% macro effect_size_table(effect_sizes) %}
\begin{table}[htbp]
\centering
\caption{Effect Size Comparison}
\label{tab:effect-sizes}
\begin{tabular}{l S[table-format=1.3] l S[table-format=1.3] S[table-format=1.3]}
\toprule
\textbf{Comparison} & \textbf{Cohen's $d$} & \textbf{Interpretation} & \textbf{Cliff's $\delta$} & \textbf{KS Stat} \\
\midrule
{% for es in effect_sizes %}
{{ es.comparison }} & {{ "%.3f" | format(es.cohens_d) }} & {{ es.interpretation }} & {{ "%.3f" | format(es.cliffs_delta) }} & {{ "%.3f" | format(es.ks_statistic) }} \\
{% endfor %}
\bottomrule
\end{tabular}
\end{table}
{% endmacro %}

